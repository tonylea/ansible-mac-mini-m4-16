<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ launch_agent_label }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/tart</string>
    <string>run</string>
    <string>{{ vm_name }}</string>
    <string>--no-graphics</string>
    <string>--net-bridged={{ vm_bridged_interface }}</string>
    <string>--disk={{ vm_dir }}/longhorn.img</string>
    <string>--disk={{ vm_dir }}/seed.iso:ro</string>
{% for drive in drives %}
    <string>--dir={{ drive.name }}:{{ drive.path }}</string>
{% endfor %}
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
